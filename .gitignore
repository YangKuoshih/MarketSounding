terraform/terraform.tfstate.backup
terraform/.terraform.tfstate.lock.info
terraform/environments/*.auto.tfvars
terraform/**/.terraform/
**/.terraform/
*.tfstate
*.tfstate.backup

# =============================================================================
# AWS credentials and config (should use SSO, never local keys)
# =============================================================================
.aws/
credentials
aws-credentials.json

# =============================================================================
# Application data (runtime-generated, not source)
# =============================================================================
data/sims/
data/events/
design-system/

